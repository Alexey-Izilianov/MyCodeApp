{
    "languages": {
        "cpp": {
            "extensions": ["c", "cc", "cpp", "cxx", "h", "hh", "hpp", "hxx", "inl"],
            "rules": [
                { "type": "preprocessor", "re": "^\\s*#\\s*(?:include\\s*(?:<[^>]*>|\"[^\"]*\")|(?:define|undef|ifn?def)\\s+\\w+|\\w+)", "color": "#e06c75" },
                { "type": "comment", "re": "//.*$|/\\*.*?(\\*/|$)", "color": "#7a7e85" },
                { "type": "string", "re": "\"(?:[^\"\\\\]|\\\\.)*\"|'(?:[^'\\\\]|\\\\.)*'", "color": "#6aab73" },
                { "type": "number", "re": "\\b(?:0[xX][0-9a-fA-F]+|\\d+\\.?\\d*(?:[eE][+-]?\\d+)?[uUlLfF]*)\\b", "color": "#b5a1e6" },
                { "type": "keyword", "re": "\\b(?:alignas|alignof|and|and_eq|asm|auto|bitand|bitor|bool|break|case|catch|char|char8_t|char16_t|char32_t|class|compl|concept|const|consteval|constexpr|constinit|const_cast|continue|co_await|co_return|co_yield|decltype|default|delete|do|double|dynamic_cast|else|enum|explicit|export|extern|false|final|float|for|friend|goto|if|inline|int|long|mutable|namespace|new|noexcept|not|not_eq|nullptr|operator|or|or_eq|override|private|protected|public|register|reinterpret_cast|requires|return|short|signed|sizeof|static|static_assert|static_cast|struct|switch|template|this|thread_local|throw|true|try|typedef|typeid|typename|union|unsigned|using|virtual|void|volatile|wchar_t|while|xor|xor_eq)\\b", "color": "#cf8e6d" }
            ]
        },
        "python": {
            "extensions": ["py", "pyw", "pyi"],
            "rules": [
                { "type": "comment", "re": "#.*$", "color": "#7a7e85" },
                { "type": "decorator", "re": "^\\s*@[\\w.]+", "color": "#b3ae60" },
                { "type": "string", "re": "(?i)\\b(?:[rbuf]{0,2})('''(?:[^']|'{1,2}(?!'))'''|\"\"\"(?:[^\"]|\"{1,2}(?!\"))\"\"\")", "color": "#6aab73" },
                { "type": "string", "re": "(?i)\\b[rbuf]{0,2}\"(?:[^\"\\\\]|\\\\.)*\"|\\b[rbuf]{0,2}'(?:[^'\\\\]|\\\\.)*'", "color": "#6aab73" },
                { "type": "number", "re": "\\b(?:0[xX][0-9a-fA-F]+|\\d+\\.?\\d*(?:[eE][+-]?\\d+)?)\\b", "color": "#b5a1e6" },
                { "type": "keyword", "re": "\\b(?:False|None|True|and|as|assert|async|await|break|class|continue|def|del|elif|else|except|finally|for|from|global|if|import|in|is|lambda|match|case|nonlocal|not|or|pass|raise|return|try|while|with|yield)\\b", "color": "#cf8e6d" }
            ]
        },
        "json": {
            "extensions": ["json", "jsonc"],
            "rules": [
                { "type": "key", "re": "\"(?:[^\"\\\\]|\\\\.)*\"(?=\\s*:)", "color": "#56a8f5" },
                { "type": "string", "re": "\"(?:[^\"\\\\]|\\\\.)*\"", "color": "#6aab73" },
                { "type": "number", "re": "-?\\d+\\.?\\d*(?:[eE][+-]?\\d+)?", "color": "#b5a1e6" },
                { "type": "keyword", "re": "\\b(?:true|false|null)\\b", "color": "#cf8e6d" }
            ]
        },
        "markdown": {
            "extensions": ["md", "markdown"],
            "rules": [
                { "type": "heading", "re": "^#{1,6}\\s.*$", "color": "#cf8e6d" },
                { "type": "bold", "re": "\\*\\*[^*]+\\*\\*|__[^_]+__", "color": "#56a8f5" },
                { "type": "code", "re": "`[^`]+`", "color": "#6aab73" }
            ]
        }
    }
}
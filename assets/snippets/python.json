{
    "Функция": {
        "prefix": "def",
        "body": ["def ${1:name}(${2}):", "\t${3:pass}$0"],
        "description": "def"
    },
    "Класс": {
        "prefix": "class",
        "body": ["class ${1:Name}:", "\tdef __init__(self${2}):", "\t\t${3:pass}$0"],
        "description": "Класс с __init__"
    },
    "Цикл for": {
        "prefix": "for",
        "body": ["for ${1:item} in ${2:items}:", "\t${3:pass}$0"],
        "description": "for ... in"
    },
    "Условие": {
        "prefix": "if",
        "body": ["if ${1:condition}:", "\t${2:pass}$0"],
        "description": "if"
    },
    "Точка входа": {
        "prefix": "main",
        "body": ["def main():", "\t${1:pass}", "", "", "if __name__ == \"__main__\":", "\tmain()$0"],
        "description": "if __name__ == \"__main__\""
    },
    "with open": {
        "prefix": "with",
        "body": ["with open(${1:path}, \"${2|r,w,a,rb,wb|}\", encoding=\"utf-8\") as ${3:f}:", "\t${4:pass}$0"],
        "description": "Открыть файл"
    },
    "try/except": {
        "prefix": "try",
        "body": ["try:", "\t${1:pass}", "except ${2:Exception} as ${3:e}:", "\t${4:raise}$0"],
        "description": "try / except"
    }
}
